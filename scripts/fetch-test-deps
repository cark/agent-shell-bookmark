#!/usr/bin/env python3
"""Fetch pinned test libraries into a cache outside the checkout."""
import json
import os
from pathlib import Path
import subprocess
import argparse

root = Path(__file__).resolve().parent.parent
cache = Path(os.environ.get("ASB_DEPS", str(Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "agent-shell-bookmark/deps")))
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--activities", action="store_true", help="also fetch optional Activities test libraries")
args = parser.parse_args()
dependencies = json.loads((root / "tests/dependencies.json").read_text())
if args.activities:
    dependencies.update(json.loads((root / "tests/activities-dependencies.json").read_text()))
for name, dependency in dependencies.items():
    destination = cache / name
    if not destination.exists():
        destination.mkdir(parents=True)
        subprocess.run(["git", "init", "-q", str(destination)], check=True)
    if subprocess.check_output(["git", "-C", str(destination), "status", "--porcelain"], text=True).strip():
        raise SystemExit(f"Dependency has local changes; leaving it alone: {destination}")
    current = subprocess.run(["git", "-C", str(destination), "rev-parse", "--verify", "HEAD"], capture_output=True, text=True)
    if current.returncode == 0 and current.stdout.strip() == dependency["rev"]:
        continue
    subprocess.run(["git", "-C", str(destination), "fetch", "--depth=1", dependency["url"], dependency["rev"]], check=True)
    subprocess.run(["git", "-C", str(destination), "checkout", "--detach", dependency["rev"]], check=True)
print(f"Dependencies ready in {cache}")
