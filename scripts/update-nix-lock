#!/usr/bin/env python3
"""Update the Nix pin without importing the checkout."""
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix="asb-lock-") as directory:
    source = Path(directory) / "source"
    source.mkdir()
    shutil.copyfile(root / "flake.nix", source / "flake.nix")
    subprocess.run(["nix", "flake", "lock", "path:" + str(source)], check=True)
    shutil.copyfile(source / "flake.lock", root / "flake.lock")
