;;; codex-smoke.el --- Opt-in live Codex restore check -*- lexical-binding: t; -*-
(require 'agent-shell-bookmark)
(require 'agent-shell-openai)

(defun asb-codex-wait (buffer)
  "Wait up to thirty seconds for BUFFER to establish a session."
  (let ((deadline (+ (float-time) 30)))
    (while (and (< (float-time) deadline)
                (not (agent-shell-session-id :shell-buffer buffer))
                (not (eq (buffer-local-value 'agent-shell-bookmark-session--status buffer) 'failed)))
      (accept-process-output nil 0.05)))
  (unless (agent-shell-session-id :shell-buffer buffer)
    (error "Codex session did not become ready")))

(let* ((root (make-temp-file "asb-codex-" t))
       (user-emacs-directory (file-name-as-directory root))
       (default-directory (file-name-as-directory root))
       (agent-shell-openai-codex-acp-command
        (list (or (getenv "ASB_CODEX_COMMAND") "codex-acp")))
       (config (agent-shell-openai-make-codex-config))
       (agent-shell-agent-configs (list config))
       (agent-shell-session-strategy 'new)
       (agent-shell-show-welcome-message nil)
       (bookmark-alist nil) (bookmark-save-flag nil)
       (bookmark-default-file (expand-file-name "bookmarks" root))
       original restored session)
  (unwind-protect
      (progn
        (setq original (agent-shell-start :config config))
        (asb-codex-wait original)
        (setq session (agent-shell-session-id :shell-buffer original))
        (with-current-buffer original
          (setq-local bookmark-make-record-function #'agent-shell-bookmark-make-record)
          (bookmark-set "Live smoke check")
          (setq-local kill-buffer-query-functions nil))
        (bookmark-save)
        (kill-buffer original)
        (setq bookmark-alist nil)
        (bookmark-load bookmark-default-file t t)
        (bookmark-jump "Live smoke check")
        (setq restored (current-buffer))
        (asb-codex-wait restored)
        (unless (equal session (agent-shell-session-id :shell-buffer restored))
          (error "Codex restored a different session"))
        (princ "Codex bookmark roundtrip passed. No prompt was sent.\n"))
    (dolist (buffer (list original restored))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (setq-local kill-buffer-query-functions nil))
        (kill-buffer buffer)))
    (delete-directory root t)))
