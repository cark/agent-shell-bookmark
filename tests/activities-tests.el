;;; activities-tests.el --- Optional real Activities integration -*- lexical-binding: t; -*-
(require 'activities)
(require 'activities-tabs)
(require 'agent-shell-bookmark)
(load "tests/integration-tests.el" nil t)

(ert-deftest asb-activities-restores-two-conversations ()
  (asb-integration-with-profile
    (let ((persist--directory-location (expand-file-name "persist" root))
          (bookmark-default-file (expand-file-name "bookmarks" root))
          (bookmark-alist nil) (bookmark-save-flag nil)
          (activities-activities nil))
      (activities-mode 1)
      (activities-tabs-mode 1)
      (agent-shell-bookmark-mode 1)
      (let ((reading (agent-shell-bookmark-session-start :config config :directory root :session "reading"))
            (planning (agent-shell-bookmark-session-start :config config :directory root :session "planning")))
        (asb-integration-wait reading)
        (asb-integration-wait planning)
        (delete-other-windows)
        (switch-to-buffer reading)
        (set-window-buffer (split-window-right) planning)
        (activities-define "Conversations")
        (activities-save-all :persistp t)
        (activities-suspend (activities-named "Conversations"))
        (dolist (view (list reading planning))
          (with-current-buffer view (setq-local kill-buffer-query-functions nil))
          (kill-buffer view))
        (activities-resume (activities-named "Conversations"))
        (let ((deadline (+ (float-time) 8)))
          (while (and (< (float-time) deadline)
                      (not (= 2 (length (seq-filter
                                         (lambda (window)
                                           (with-current-buffer (window-buffer window)
                                             (derived-mode-p 'agent-shell-mode)))
                                         (window-list))))))
            (sit-for 0.03)))
        (let ((views (mapcar #'window-buffer (window-list))))
          (should (= 2 (length views)))
          (dolist (view views) (asb-integration-wait view))
          (should (equal (sort (mapcar (lambda (view) (agent-shell-session-id :shell-buffer view)) views) #'string<)
                         '("planning" "reading")))
          (activities-revert (activities-named "Conversations"))
          (sit-for 0.1)
          (should (seq-set-equal-p views (mapcar #'window-buffer (window-list))))))
      (agent-shell-bookmark-mode -1)
      (activities-tabs-mode -1)
      (activities-mode -1))))

(ert-run-tests-batch-and-exit "^asb-activities-")
